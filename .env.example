# Copy to .env and fill in before `docker compose up`.

# Required: password for the pantry Postgres role.
POSTGRES_PASSWORD=change-me

# Hostname or IP Caddy serves. With a bare IP it still issues a self-signed
# certificate from its local CA; browsers will warn until you trust it.
SITE_ADDRESS=localhost

# Browser origins allowed to call the API. Same-origin through Caddy is "*".
CORS_ORIGIN=*

# Postgres connection pool and ranking memory per connection. Raise work_mem
# on a machine with spare RAM; lower both on a 1 GB VPS.
DB_POOL_MAX=8
DB_WORK_MEM=32MB
